{
  "name": "cloudtypora",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:frontend": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-frontend.ps1",
    "dev:backend": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-backend.ps1",
    "lint": "pnpm --dir frontend lint",
    "typecheck": "pnpm --dir frontend typecheck",
    "test": ".\\.venv\\Scripts\\python.exe -m pytest backend/tests"
  },
  "workspaces": [
    "frontend"
  ]
}
